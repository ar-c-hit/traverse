# Traverse - Full-Stack Environment Variables Reference

# ==============================================================================
# Backend (Server / Render) Configuration
# ==============================================================================
# Port for Express server (Render sets PORT automatically)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# MongoDB Atlas connection string (never commit real credentials)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/traverse?retryWrites=true&w=majority

# Secret key for signing JWT tokens (generate a 32+ character random string)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Client URL for CORS policy and WebSocket authorization
CLIENT_URL=https://your-app.vercel.app
CLIENT_ORIGIN=https://your-app.vercel.app

# Optional Admin seed credentials
ADMIN_EMAIL=admin@traverse.com
ADMIN_DEFAULT_PASSWORD=admin123

# ==============================================================================
# Frontend (Client / Vercel) Configuration (VITE_ prefix required)
# ==============================================================================
# Render backend URL (no trailing slash)
VITE_API_URL=https://your-backend.onrender.com

# Optional Public Support contact information
VITE_SUPPORT_EMAIL=support@traverse.com
VITE_SUPPORT_PHONE=+1 (800) 555-0199
