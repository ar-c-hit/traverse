# Server Port (Render automatically sets this to 10000)
PORT=5000

# Node Environment
NODE_ENV=production

# MongoDB Atlas URI (Use your Atlas database connection string)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/traverse?retryWrites=true&w=majority

# JWT Secret for secure traveler authentication sessions (generate a secure random string)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Frontend Vercel App URL (used for CORS and WebSockets)
CLIENT_URL=https://your-app.vercel.app
CLIENT_ORIGIN=https://your-app.vercel.app

# Optional: Super Admin Seed Credentials
ADMIN_EMAIL=admin@traverse.com
ADMIN_DEFAULT_PASSWORD=admin123
